\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Three paradigms of event-driven financial analysis. (a)\nonbreakingspace Event studies average CAR by event type---rigorous but post-hoc. (b)\nonbreakingspace LLM analysis restores event richness but is validated by a judge sharing the evaluatee's blind spots. (c)\nonbreakingspace PRONOIA structures each event, propagates it over an economic graph, and lets post-event market data settle every claim---closing the reason--verify--revise loop.}}{1}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:paradigm}{{1}{1}{Three paradigms of event-driven financial analysis. (a)~Event studies average CAR by event type---rigorous but post-hoc. (b)~LLM analysis restores event richness but is validated by a judge sharing the evaluatee's blind spots. (c)~PRONOIA structures each event, propagates it over an economic graph, and lets post-event market data settle every claim---closing the reason--verify--revise loop}{figure.caption.1}{}}
