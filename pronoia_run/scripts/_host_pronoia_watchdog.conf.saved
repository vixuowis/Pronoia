; pronoia_watchdog.conf  ——  挂到 supervisord 下的守护
;   作用：容器/PID 1 只要活着，watchdog 就一定运行；watchdog 挂了 supervisor 自动起（autorestart=true）
;   安装：复制到 /etc/supervisor/conf.d/pronoia_watchdog.conf
;         然后 supervisorctl reload && supervisorctl update
[program:pronoia_watchdog]
command=/bin/bash /workspace/pronoia_run/scripts/pronoia_watchdog.sh
directory=/workspace
user=root
autostart=true
autorestart=true
startretries=10
startsecs=5
stopasgroup=true
killasgroup=true
stdout_logfile=/workspace/pronoia_run/logs/pronoia_watchdog.supervisor.stdout.log
stderr_logfile=/workspace/pronoia_run/logs/pronoia_watchdog.supervisor.stderr.log
stdout_logfile_maxbytes=20MB
stderr_logfile_maxbytes=20MB
stdout_logfile_backups=5
stderr_logfile_backups=5
