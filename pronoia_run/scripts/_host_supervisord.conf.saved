[supervisord]
logfile=/var/log/tool/supervisord.log
pidfile=/var/run/supervisord.pid
nodaemon=true
user=root

[supervisorctl]
serverurl=unix:///run/supervisor.sock

[unix_http_server]
file=/run/supervisor.sock

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface

[program:agent-tool-host]
command=/app/bin/agent-tool-host
environment=TOOLHOST_CWD="/workspace",AGENT_TOOL_HOST_MCP_SERVER_CONF_FILE="/app/etc/mcp_servers.json",AGENT_TOOL_HOST_IDE_DYNAMIC_CONF_FILE="/app/etc/ide_dynamic_config_basic.json",LD_LIBRARY_PATH="/app/lib",ICUBE_USER_DATA_DIR="/data/user",TOOLHOST_JOB_LOG_DIR="/var/log/tool/jobs",BROWSER_SNAPSHOT_DIR="/data/tool/browser_snapshots",CDP_USER_DATA_DIR="/data/tool/cdp-client-browser",CRAWLER_CDP_ENDPOINT="http://127.0.0.1:8088/v1/cdp",OPEN_PREVIEW_CDP_ENDPOINT="http://127.0.0.1:8088/v1/cdp",MCP_LOG_DIR="/var/log/tool/mcp"
directory=/workspace
autostart=true
autorestart=true
startretries=3
startsecs=2
stdout_logfile=/var/log/tool/agent-tool-host.stdout.log
stderr_logfile=/var/log/tool/agent-tool-host.stderr.log
stdout_logfile_maxbytes=50MB
stderr_logfile_maxbytes=50MB
stdout_logfile_backups=3
stderr_logfile_backups=3

[include]
files = /etc/supervisor/conf.d/*.conf
